class_name Levels
extends RefCounted

## 关卡数据。ASCII 是唯一数据源：改关卡 = 改这里的字符串，不用打开编辑器。
##
## 符号表：
##   #  墙        .  地面      P  本体起点   S  影子起点
##   E  出口      D  锁门      K  钥匙     a/b/p  压力板
##
## exit_needs：出口开启前必须被压住过的压力板 id；空数组表示出口一开始就是开的。

const DATA := [
	{
		"name": "回声初醒",
		"hint": "方向键移动。影子会重复你上一拍走的方向。",
		"map": [
			"#######",
			"#P...E#",
			"#.....#",
			"#..S..#",
			"#######",
		],
		"exit_needs": [],
	},
]


## 仅用于开发自检的机关测试室。**不是正式关卡**，不进 DATA，正常游玩不会加载。
## 用来一次跑通：拾钥匙 → 撞门开锁 → 下一拍进门 → 踩板开出口 → 通关。
##   #P.K.DaE#   P(1,1) K(3,1) D(5,1) a(6,1) E(7,1)
const FIXTURE_MECHANISMS := {
	"name": "机关测试室",
	"hint": "",
	"map": [
		"#########",
		"#P.K.DaE#",
		"#.......#",
		"#..S....#",
		"#########",
	],
	"exit_needs": ["a"],
}
